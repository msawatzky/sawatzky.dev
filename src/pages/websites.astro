---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import PricingCard from "../components/PricingCard.astro";

const included = [
  "A design that fits how you talk about the business",
  "Pages that stay clear on a phone",
  "The site set up and live, with a simple way to make later changes",
  "You own the finished site",
];
---

<Layout
  title="Rapid, Lightweight Websites | Sawatzky Development"
  description="Rapid, lightweight websites. A fast, well-designed site for businesses that need a clear presence online."
>
  <section class="mx-auto w-full max-w-6xl px-4 pb-8 pt-8 sm:px-6 sm:pt-10 lg:px-8">
    <div class="hero-panel relative overflow-hidden rounded-3xl px-6 py-10 sm:px-10 sm:py-14 lg:px-12">
    <div class="relative">
    <p class="tag-accent w-fit">Website solutions</p>
    <h1 class="font-serif mt-5 max-w-3xl text-balance text-4xl font-semibold leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-6xl">
      Rapid, lightweight websites.
    </h1>
    <p class="mt-6 max-w-2xl text-pretty text-base leading-relaxed text-slate-300 sm:text-lg">
      A site that explains what you do, shows why people should trust you, and makes it easy to get in touch. It looks considered, opens quickly, and does not come with a pile of monthly fees.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="#" data-contact-open class="btn-primary">
        Ask about a site
        <Icon name="arrow" class="h-4 w-4" />
      </a>
      <a href="#pricing" class="btn-ghost">
        See starting points
      </a>
    </div>
    </div>
    </div>
  </section>

  <section>
    <div class="mx-auto grid w-full max-w-6xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:px-8">
      <div>
        <p class="kicker">What you get</p>
        <h2 class="font-serif mt-3 text-3xl font-semibold tracking-tight text-slate-950">Built to be finished.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600">
          A focused site with a look chosen for your business. It is quick to open, clear on a phone, and simple to update later.
        </p>
        <ul class="mt-6 space-y-3">
          {
            included.map((item) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed text-slate-700">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-cyan-700" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="grid gap-4">
        <article class="tech-card tech-card-cyan">
          <h3 class="font-semibold text-slate-950">A good fit when</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            You need a public website more than a custom tool. What you say on it will not change every day. You want it done carefully, then left to do its job.
          </p>
        </article>
        <article class="tech-card tech-card-indigo">
          <h3 class="font-semibold text-slate-950">A different project when</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            You need customer logins, a shop, bookings with real rules, or something that has to work with your other tools. I do that work too. It is just a different kind of project.
          </p>
          <a href="/#help" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-cyan-700 hover:text-cyan-600">
            See the other ways I can help
            <Icon name="arrow" class="h-4 w-4" />
          </a>
        </article>
      </div>
    </div>
  </section>

  <section id="pricing" class="scroll-mt-24 pb-8">
    <div class="mx-auto w-full max-w-6xl px-4 pb-16 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="kicker">Pricing</p>
        <h2 class="font-serif mt-3 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">Starting points</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600">
          Typical prices for a business website. If you need more than a site, we will talk about that on its own instead of forcing it into one of these.
        </p>
      </div>

      <div class="mt-8 rounded-2xl border border-cyan-400/40 bg-white p-6 shadow-[0_10px_30px_-18px_rgba(15,23,42,0.45)] sm:p-8">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-xl">
            <p class="kicker">Optional first step</p>
            <h3 class="font-serif mt-2 text-2xl font-semibold text-slate-950 sm:text-3xl">A $50 one-page demo</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600 sm:text-base">
              I design a single page around your business. If you continue, the $50 goes toward the setup cost. Useful when you want to see the work before a full site.
            </p>
          </div>
          <a href="#" data-contact-open class="btn-primary shrink-0 whitespace-nowrap">
            Request a demo
            <Icon name="arrow" class="h-4 w-4" />
          </a>
        </div>
      </div>

      <div class="mt-6 grid gap-5 md:grid-cols-3">
        <PricingCard
          name="Starter"
          price="$350 setup + $50/mo"
          description="A focused one-page site for a single offer."
          includes="Includes 30 minutes of monthly updates"
          ctaLabel="Ask about Starter"
        />
        <PricingCard
          name="Professional"
          price="$750 setup + $100/mo"
          description="A multi-page site with room for services, proof, and a clearer story."
          includes="Includes 60 minutes of monthly updates"
          popular={true}
          ctaLabel="Ask about Professional"
        />
        <PricingCard
          name="Custom"
          price="We'll price it together"
          description="A shop, bookings, or anything bigger than a straightforward website."
          includes="Priced after a short conversation"
          ctaLabel="Talk through it"
        />
      </div>
    </div>
  </section>
</Layout>
