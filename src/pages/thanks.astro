---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout
  title="Thanks | Sawatzky Development"
  description="Thanks for reaching out to Sawatzky Development."
>
  <section class="mx-auto flex min-h-[calc(100dvh-10rem)] w-full max-w-2xl items-center px-4 py-16 sm:px-6">
    <div class="w-full rounded-2xl border border-stone-200 bg-white p-6 sm:p-10">
      <div class="flex flex-col items-start gap-4">
        <div class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-teal-800/10 text-teal-800">
          <Icon name="check" class="h-6 w-6" />
        </div>
        <h1 class="font-serif text-balance text-3xl font-medium tracking-tight text-stone-950 sm:text-4xl">Thanks — your note is in.</h1>
        <p class="max-w-xl text-sm leading-relaxed text-stone-600 sm:text-base">
          I read every inquiry myself and usually reply within one business day with a direct next step.
        </p>
      </div>
      <div class="mt-8">
        <a href="/" class="btn-primary">
          Back home
        </a>
      </div>
    </div>
  </section>
</Layout>
