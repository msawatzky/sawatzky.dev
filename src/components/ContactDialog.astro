---
const formAction = "https://formspree.io/f/xpqkqely";
const hasServerEndpoint = true;
---

<dialog
  id="contact-dialog"
  class="m-auto w-[calc(100%-2rem)] max-h-[85vh] max-w-lg overflow-y-auto rounded-2xl border border-stone-200 bg-white p-0 text-stone-900 shadow-xl backdrop:bg-stone-950/40"
  aria-labelledby="contact-dialog-title"
>
  <div class="border-b border-stone-200 px-5 py-4 sm:px-6">
    <h2 id="contact-dialog-title" class="font-serif text-2xl font-medium text-stone-950">Tell me what you need</h2>
    <p class="mt-1 text-sm leading-relaxed text-stone-500">
      Consulting, software, a website, or a question you have not named yet. No package required to start.
    </p>
  </div>
  <form
    id="contact-form"
    class="px-5 py-4 sm:px-6 sm:pb-6"
    method={hasServerEndpoint ? "POST" : "post"}
    action={hasServerEndpoint ? formAction : undefined}
    data-has-endpoint={hasServerEndpoint ? "true" : "false"}
  >
    {hasServerEndpoint && <input type="hidden" name="_subject" value="Sawatzky.dev - new inquiry" />}
    <div class="space-y-4">
      <label class="block">
        <span class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-stone-500">What are you looking for?</span>
        <select
          name="inquiryType"
          class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-teal-700 focus:outline-none focus:ring-1 focus:ring-teal-700"
        >
          <option value="Not sure yet">Not sure yet — let's talk</option>
          <option value="Advice">Advice on a project or decision</option>
          <option value="Custom build">Something custom built for my business</option>
          <option value="Rapid website">A rapid, lightweight website</option>
          <option value="$50 website demo">The $50 one-page website demo</option>
        </select>
      </label>
      <label class="block">
        <span class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-stone-500">Name</span>
        <input
          type="text"
          name="name"
          required
          autocomplete="name"
          class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 placeholder:text-stone-400 focus:border-teal-700 focus:outline-none focus:ring-1 focus:ring-teal-700"
          placeholder="Your name"
        />
      </label>
      <label class="block">
        <span class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-stone-500">Email</span>
        <input
          type="email"
          name="email"
          required
          autocomplete="email"
          class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 placeholder:text-stone-400 focus:border-teal-700 focus:outline-none focus:ring-1 focus:ring-teal-700"
          placeholder="you@company.com"
        />
      </label>
      <label class="block">
        <span class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-stone-500">Organization (optional)</span>
        <input
          type="text"
          name="business"
          autocomplete="organization"
          class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 placeholder:text-stone-400 focus:border-teal-700 focus:outline-none focus:ring-1 focus:ring-teal-700"
          placeholder="Company or project name"
        />
      </label>
      <label class="block">
        <span class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-stone-500">How can I help?</span>
        <textarea
          name="message"
          required
          rows="4"
          class="w-full resize-y rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 placeholder:text-stone-400 focus:border-teal-700 focus:outline-none focus:ring-1 focus:ring-teal-700"
          placeholder="What is going on, what you have tried, and what a good outcome looks like."
        ></textarea>
      </label>
    </div>
    <p class="mt-4 text-xs leading-relaxed text-stone-500">I reply personally. A website demo, if you want one, is credited toward setup.</p>
    {!hasServerEndpoint && (
      <p class="mt-2 text-xs text-amber-700">
        Form endpoint is not configured yet. Add <code>PUBLIC_CONTACT_FORM_ACTION</code> to enable submissions.
      </p>
    )}
    <div class="mt-5 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
      <button
        type="button"
        class="rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 transition hover:bg-stone-50"
        data-contact-close
      >
        Cancel
      </button>
      <button
        type="submit"
        class="rounded-full bg-teal-800 px-4 py-2 text-sm font-semibold text-white transition hover:bg-teal-700"
      >
        Send message
      </button>
    </div>
  </form>
</dialog>

<script>
  const dialog = document.getElementById("contact-dialog");
  const form = document.getElementById("contact-form");
  const submitButton = form?.querySelector('button[type="submit"]');
  const successRedirectPath = "/thanks";

  function openContact(e) {
    e.preventDefault();
    if (dialog && "showModal" in dialog) dialog.showModal();
  }

  function closeContact() {
    if (dialog && "close" in dialog) dialog.close();
  }

  document.querySelectorAll("[data-contact-open]").forEach((el) => {
    el.addEventListener("click", openContact);
  });

  document.querySelectorAll("[data-contact-close]").forEach((el) => {
    el.addEventListener("click", closeContact);
  });

  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) closeContact();
  });

  form?.addEventListener("submit", (e) => {
    if (form.dataset.hasEndpoint !== "true") {
      e.preventDefault();
      alert("Contact form is not configured yet. Please set PUBLIC_CONTACT_FORM_ACTION.");
      return;
    }

    e.preventDefault();
    const action = form.getAttribute("action");
    if (!action) {
      alert("Contact form endpoint is missing.");
      return;
    }

    submitButton?.setAttribute("disabled", "true");
    submitButton?.classList.add("opacity-70", "cursor-not-allowed");

    fetch(action, {
      method: "POST",
      body: new FormData(form),
      headers: {
        Accept: "application/json",
      },
    })
      .then((response) => {
        if (!response.ok) throw new Error("Request failed");
        closeContact();
        form.reset();
        window.location.assign(successRedirectPath);
      })
      .catch(() => {
        alert("Could not send your message right now. Please try again.");
      })
      .finally(() => {
        submitButton?.removeAttribute("disabled");
        submitButton?.classList.remove("opacity-70", "cursor-not-allowed");
      });
  });
</script>
