---
import Icon from "./Icon.astro";

interface Props {
  name: string;
  price: string;
  description: string;
  includes: string;
  popular?: boolean;
  ctaLabel?: string;
}

const {
  name,
  price,
  description,
  includes,
  popular = false,
  ctaLabel = "Get started",
} = Astro.props;
---

<article
  class:list={[
    "relative flex flex-col rounded-2xl border p-5 sm:p-6",
    popular
      ? "card-interactive-popular border-cyan-400/50 bg-white ring-1 ring-cyan-400/30"
      : "card-interactive border-slate-200 bg-white",
  ]}
>
  {
    popular && (
      <span class="absolute -top-3 left-5 rounded-full bg-cyan-400 px-3 py-0.5 text-[0.65rem] font-bold uppercase tracking-[0.12em] text-slate-950">
        Common starting point
      </span>
    )
  }
  <h3 class="text-lg font-semibold text-slate-950">{name}</h3>
  <p class="mt-2 text-xl font-semibold tabular-nums text-slate-950">{price}</p>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{description}</p>
  <p class="mt-4 flex items-start gap-2 text-sm text-slate-600">
    <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-cyan-700" />
    {includes}
  </p>
  <a
    href="#"
    data-contact-open
    class:list={[
      "mt-5 inline-flex items-center justify-center rounded-full px-4 py-2.5 text-sm font-semibold transition duration-200",
      popular
        ? "bg-cyan-400 text-slate-950 hover:bg-cyan-300"
        : "border border-slate-300 bg-white text-slate-800 hover:border-cyan-400",
    ]}
  >
    {ctaLabel}
  </a>
</article>
